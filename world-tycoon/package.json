{
  "name": "world-tycoon",
  "version": "1.0.6",
  "description": "World Tycoon: Global Edition — 3D Isometric Monopoly-style board game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:html": "node tools/assemble-html.js",
    "build:css": "node tools/build-css.js",
    "build": "node tools/build-css.js && vite build",
    "preview": "vite preview",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@vercel/analytics": "^2.0.1",
    "svelte": "^5.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
