{
  "name": "world-tycoon",
  "version": "1.0.0",
  "description": "World Tycoon: Global Edition — 3D Isometric Monopoly-style board game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/compiled.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "test": "node --test test/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
