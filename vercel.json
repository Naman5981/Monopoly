{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix world-tycoon install",
  "buildCommand": "npm --prefix world-tycoon run build",
  "outputDirectory": "world-tycoon/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
